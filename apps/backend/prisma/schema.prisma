// CinneTemple — Prisma schema (Phase 1: Identity & Access)
// See docs/DATABASE.md for the design rationale.

generator client {
  provider      = "prisma-client-js"
  // Bundle the engine for the container's platform (Debian + OpenSSL 3) as well
  // as the local dev machine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  EMAIL
  APPLE
  GOOGLE
  PASSKEY
}

model User {
  korapayTestTopups KorapayTestTopup[]
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  passwordHash      String?            @map("password_hash")
  cognitoSub        String?            @unique @map("cognito_sub")
  status            UserStatus         @default(PENDING_VERIFICATION)
  emailVerified     Boolean            @default(false) @map("email_verified")
  mfaEnabled        Boolean            @default(false) @map("mfa_enabled")
  phoneNumberEnc    Bytes?             @map("phone_number_enc")

  profile           Profile?
  sessions          Session[]
  roles             UserRole[]
  credentials       Credential[]
  auditLogs         AuditLog[]            @relation("AuditActor")
  watchlist         WatchlistItem[]
  devices           DeviceToken[]
  purchases         Purchase[]            @relation("Payer")
  giftsReceived     Purchase[]            @relation("Beneficiary")
  entitlements      Entitlement[]
  chatMessages      PremiereChatMessage[]
  playbackProgress  PlaybackProgress[]
  episodePlayback   EpisodePlayback[]
  desktopAuthCodes  DesktopAuthCode[]
  coinWallet        CoinWallet?
  coinLedger        CoinLedgerEntry[]
  coinTopups        CoinTopup[]
  poolContributions PoolContribution[]

  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String  @map("display_name")
  avatarUrl   String? @map("avatar_url")
  locale      String  @default("en")
  bio         String?

  history   ProfileHistory[]
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  @@map("profiles")
}

model ProfileHistory {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId])
  @@map("profile_history")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  users     UserRole[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Credential {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  providerId String       @map("provider_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@index([userId])
  @@map("credentials")
}

/// A user's saved title. Title metadata lives in DynamoDB; this row links a user
/// to a catalogue title id (the cross-store relationship).
model WatchlistItem {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String    @map("title_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, titleId])
  @@index([userId])
  @@map("watchlist_items")
}

enum DevicePlatform {
  IOS
  WEB
}

/// A registered device for push notifications. `endpointArn` is the SNS platform
/// endpoint created when the token is registered.
model DeviceToken {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    DevicePlatform
  token       String
  endpointArn String?        @map("endpoint_arn")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([token])
  @@index([userId])
  @@map("device_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Commerce: pay-per-view (mobile cinema). Catalogue metadata (title, price,
// premiere flags, video key) lives in the catalogue store (DynamoDB/local seed);
// money + access rights are transactional and live here in Postgres.
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  COINS
  MOCK
  PAYSTACK
  KORAPAY
  APPLE_IAP
  GOOGLE_PLAY
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE // purchased, not yet started OR within the viewing window
  EXPIRED // viewing window elapsed
  CONSUMED // finished
  REVOKED
}

/// A single pay-per-view transaction. `userId` is the payer; `beneficiaryUserId`
/// is who gets to watch (same as payer unless it was gifted).
model Purchase {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  user              User            @relation("Payer", fields: [userId], references: [id], onDelete: Cascade)
  beneficiaryUserId String          @map("beneficiary_user_id") @db.Uuid
  beneficiary       User            @relation("Beneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  titleId           String          @map("title_id") @db.Uuid
  titleName         String          @map("title_name")
  amountMinor       Int             @map("amount_minor") // smallest currency unit (kobo/cents)
  currency          String          @default("NGN")
  provider          PaymentProvider
  providerRef       String?         @unique @map("provider_ref")
  status            PurchaseStatus  @default(PENDING)
  isGift            Boolean         @default(false) @map("is_gift")
  entitlement       Entitlement?
  createdAt         DateTime        @default(now()) @map("created_at")
  paidAt            DateTime?       @map("paid_at")

  @@index([userId])
  @@index([beneficiaryUserId])
  @@index([titleId])
  @@index([status])
  @@map("purchases")
}

/// The right to watch a title once, for the duration of the movie. Created when a
/// purchase is paid; the viewing window opens on first play (`startedAt`).
model Entitlement {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId    String            @map("title_id") @db.Uuid
  purchaseId String            @unique @map("purchase_id") @db.Uuid
  purchase   Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  status     EntitlementStatus @default(ACTIVE)
  startedAt  DateTime?         @map("started_at")
  expiresAt  DateTime?         @map("expires_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([userId, titleId])
  @@index([status])
  @@map("entitlements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue: the persistent source of truth for titles (replaces the volatile
// in-memory/DynamoDB stores). Mirrors the Title domain entity in
// src/modules/catalogue/domain/title.entity.ts — keep the two in sync.
// ─────────────────────────────────────────────────────────────────────────────

enum TitleType {
  MOVIE
  SERIES
}

enum TitleStatus {
  DRAFT
  PUBLISHED
}

/// A catalogue title (movie or series). Array columns (genres/cast/categories)
/// are native Postgres text[]; media fields hold object keys resolved to URLs
/// by the service layer.
model CatalogueTitle {
  id              String      @id @db.Uuid
  type            TitleType
  title           String
  tagline         String?
  overview        String
  year            Int
  genres          String[]
  runtimeMinutes  Int?        @map("runtime_minutes")
  seasons         Int?
  maturityRating  String?     @map("maturity_rating")
  rating          Float       @default(0)
  posterKey       String?     @map("poster_key")
  heroKey         String?     @map("hero_key")
  cast            String[]    @map("cast_members")
  director        String?
  categories      String[]
  popularity      Int         @default(0)
  featured        Boolean     @default(false)
  status          TitleStatus @default(DRAFT)
  priceMinor      Int         @default(0) @map("price_minor")
  currency        String      @default("NGN")
  videoKey        String?     @map("video_key")
  trailerKey      String?     @map("trailer_key")
  durationSeconds Int?        @map("duration_seconds")
  isPremiere      Boolean     @default(false) @map("is_premiere")
  premiereStartAt DateTime?   @map("premiere_start_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // ── Classification (see docs/content-classification.md) ────────────────────
  /// Null = derived: SERIES → TV_SERIES, MOVIE → FEATURE_FILM.
  contentFormat       ContentFormat? @map("content_format")
  audience            Audience?
  /// Certified age rating (e.g. "18", "PG-13"); never inferred from `audience`.
  ageRating           String?        @map("age_rating")
  /// Body that issued `ageRating`, e.g. "NG-NFVCB", "US-MPA".
  ratingJurisdiction  String?        @map("rating_jurisdiction")
  /// Original release date. Null = 1 Jan of `year`.
  releaseDate         DateTime?      @map("release_date") @db.Date
  /// Null = derived from price: 0 → FREE, otherwise PAY_PER_VIEW.
  accessType          AccessType?    @map("access_type")
  /// ISO 3166-1 alpha-2, upper case ("NG", "GH").
  productionCountries String[]       @map("production_countries")
  /// Lower-case language codes ("en", "yo", "ig", "ha", "pcm").
  originalLanguages   String[]       @map("original_languages")
  audioLanguages      String[]       @map("audio_languages")
  /// Rights window. Outside it the title is not shown on the homepage.
  availableFrom       DateTime?      @map("available_from")
  availableUntil      DateTime?      @map("available_until")
  /// Series only: every planned episode is out.
  seriesComplete      Boolean        @default(false) @map("series_complete")
  /// First time the title was published (drives "Newly Added").
  publishedAt         DateTime?      @map("published_at")

  seasonRecords   Season[]
  genreLinks      TitleGenre[]
  tagLinks        TitleTag[]
  industryLinks   TitleIndustry[]
  collectionLinks TitleCollection[]

  @@index([status])
  @@index([featured])
  @@index([popularity])
  @@index([isPremiere, status])
  @@map("catalogue_titles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Series: seasons & episodes. One ticket buys the series; EACH EPISODE is
// watchable exactly once (per-episode watch-once mirrors the movie flow).
// `CatalogueTitle.seasons` stays a derived count maintained on season
// create/delete by the admin series service.
// ─────────────────────────────────────────────────────────────────────────────

model Season {
  id       String         @id @default(uuid()) @db.Uuid
  titleId  String         @map("title_id") @db.Uuid
  title    CatalogueTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  number   Int
  name     String?
  overview String?

  episodes  Episode[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([titleId, number])
  @@map("seasons")
}

model Episode {
  id              String  @id @default(uuid()) @db.Uuid
  seasonId        String  @map("season_id") @db.Uuid
  season          Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  /// Denormalized series title id so playback/consumption checks avoid a join.
  titleId         String  @map("title_id") @db.Uuid
  number          Int
  name            String
  overview        String?
  runtimeMinutes  Int?    @map("runtime_minutes")
  /// Playback length in seconds; defines the per-episode viewing window.
  durationSeconds Int?    @map("duration_seconds")
  /// Object key for the playable master. Resolved to a signed URL on play —
  /// never exposed to viewers directly.
  videoKey        String? @map("video_key")
  /// Episode still artwork (public image, like posters).
  stillKey        String? @map("still_key")

  playback  EpisodePlayback[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([seasonId, number])
  @@index([titleId])
  @@map("episodes")
}

/// Per-episode watch-once state (mirror of the movie flow's entitlement window
/// + PlaybackProgress, scoped to one episode). `consumedAt` is stamped at
/// >=95% progress; a consumed episode can never be streamed again.
model EpisodePlayback {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId       String    @map("episode_id") @db.Uuid
  episode         Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  titleId         String    @map("title_id") @db.Uuid
  positionSeconds Int       @default(0) @map("position_seconds")
  durationSeconds Int       @map("duration_seconds")
  startedAt       DateTime? @map("started_at")
  expiresAt       DateTime? @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, episodeId])
  @@index([userId, titleId])
  @@map("episode_playback")
}

/// Single-use PKCE-style device-link code for the desktop app. Only the
/// SHA-256 of the code is stored; the challenge is base64url(SHA-256(verifier))
/// supplied by the desktop client via the web approval page.
model DesktopAuthCode {
  id         String    @id @default(uuid()) @db.Uuid
  codeHash   String    @unique @map("code_hash")
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("desktop_auth_codes")
}

/// Resume-watching position per user per title. Endpoints land in a later
/// phase; the model ships with the catalogue persistence migration.
model PlaybackProgress {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId         String   @map("title_id") @db.Uuid
  positionSeconds Int      @map("position_seconds")
  durationSeconds Int      @map("duration_seconds")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, titleId])
  @@index([userId])
  @@map("playback_progress")
}

/// A live-chat message attached to a title's premiere.
model PremiereChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  titleId   String   @map("title_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([titleId, createdAt])
  @@map("premiere_chat_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Funding engine: coins. 1 coin = ₦1. Viewers buy coins (Paystack), fund a
// film's pool with them, claim refunds in coins, and send coins to each other.
// When the admin sets a pool's payout, each coin is worth payout ÷ pool coins
// and backers are credited in coins. Coins never convert back to cash here.
//
// `CoinWallet.balance` is the spendable balance; every change to it writes one
// append-only `CoinLedgerEntry` in the same transaction, so the ledger always
// sums to the balance.
// ─────────────────────────────────────────────────────────────────────────────

enum CoinLedgerKind {
  APPLE_REFUND
  APPLE_REFUND_REVERSAL
  TICKET_PURCHASE
  TOPUP // bought with naira
  POOL_FUND // moved into a film pool
  POOL_REFUND // refund claim / cancelled pool, returned as coins
  POOL_PAYOUT // backer's share of a pool payout
  TRANSFER_OUT // sent to another user
  TRANSFER_IN // received from another user
}

enum CoinTopupStatus {
  REFUNDED
  PENDING
  PAID
  FAILED
}

enum FundingPoolStatus {
  OPEN // accepting coins; refund claims allowed
  CLOSED // funding stopped, awaiting payout
  PAID_OUT // payout set and credited (final)
  CANCELLED // every backer refunded in coins (final)
}

model CoinWallet {
  userId     String   @id @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance    Int      @default(0)
  refundDebt Int      @default(0) @map("refund_debt")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("coin_wallets")
}

/// Append-only. `delta` is signed (+credit / −debit); `balanceAfter` is the
/// wallet balance once this entry applied. `idempotencyKey` makes each money
/// movement land at most once (top-up reference, transfer key, pool op id).
model CoinLedgerEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               CoinLedgerKind
  delta              Int
  balanceAfter       Int            @map("balance_after")
  poolId             String?        @map("pool_id") @db.Uuid
  counterpartyUserId String?        @map("counterparty_user_id") @db.Uuid
  note               String?
  idempotencyKey     String         @unique @map("idempotency_key")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([poolId])
  @@map("coin_ledger")
}

/// A naira → coin purchase. `amountMinor` is kobo (coins × 100).
model CoinTopup {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coins       Int
  amountMinor Int             @map("amount_minor")
  currency    String          @default("NGN")
  provider    PaymentProvider
  reference   String          @unique
  status      CoinTopupStatus @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at")
  paidAt      DateTime?       @map("paid_at")

  @@index([userId])
  @@index([status])
  @@map("coin_topups")
}

/// Durable refund marker also exists when Apple's callback precedes settlement.
model AppleCoinRefundState {
  transactionId  String   @id @map("transaction_id")
  productId      String   @map("product_id")
  userId         String   @map("user_id") @db.Uuid
  refunded       Boolean
  signedAt       BigInt   @map("signed_at")
  notificationId String   @map("notification_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("apple_coin_refund_states")
}

model AppleStoreNotification {
  id            String   @id
  type          String
  transactionId String?  @map("transaction_id")
  signedAt      BigInt   @map("signed_at")
  outcome       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("apple_store_notifications")
}

/// Apple review/TestFlight transactions share the main API, never the live ledger.
model AppleSandboxCoinPurchase {
  transactionId String   @id @map("transaction_id")
  userId        String   @map("user_id") @db.Uuid
  coins         Int
  confirmed     Boolean  @default(false)
  refunded      Boolean  @default(false)
  signedAt      BigInt   @default(0) @map("signed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("apple_sandbox_coin_purchases")
}

model AppleSandboxCoinSpend {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  coins     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("apple_sandbox_coin_spends")
}

/// A film's funding pool. `totalCoins` is the live sum of backers' net coins
/// (contributed − refunded). `payoutCoins` is set once, when the admin pays out.
model FundingPool {
  id          String            @id @default(uuid()) @db.Uuid
  /// Optional link to a catalogue title (a film can be funded before it exists).
  titleId     String?           @map("title_id") @db.Uuid
  name        String
  description String?
  goalCoins   Int?              @map("goal_coins")
  totalCoins  Int               @default(0) @map("total_coins")
  status      FundingPoolStatus @default(OPEN)
  payoutCoins Int?              @map("payout_coins")
  closesAt    DateTime?         @map("closes_at")
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  closedAt    DateTime?         @map("closed_at")
  paidOutAt   DateTime?         @map("paid_out_at")

  contributions PoolContribution[]

  @@index([status])
  @@index([titleId])
  @@map("funding_pools")
}

/// One row per backer per pool. Net stake = coins − refundedCoins.
model PoolContribution {
  id            String      @id @default(uuid()) @db.Uuid
  poolId        String      @map("pool_id") @db.Uuid
  pool          FundingPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  userId        String      @map("user_id") @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  coins         Int         @default(0)
  refundedCoins Int         @default(0) @map("refunded_coins")
  payoutCoins   Int?        @map("payout_coins")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([poolId, userId])
  @@index([userId])
  @@map("pool_contributions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Producers. After a film is uploaded the admin enters the producer's email;
// the producer receives a private dashboard link (no account needed) showing
// their films' views and earnings, and can request naira withdrawals.
//
// The link carries a random key; only its SHA-256 is stored. Re-sending the link
// rotates the key (old links stop working). Withdrawals additionally need a
// 6-digit code emailed to the producer, so a leaked link alone can't move money.
// ─────────────────────────────────────────────────────────────────────────────

enum ProducerWithdrawalStatus {
  AWAITING_CONFIRMATION // created, waiting for the emailed code
  REQUESTED // confirmed by the producer, in the admin payout queue
  PAID // admin sent the bank transfer
  REJECTED // admin declined (funds return to the available balance)
  EXPIRED // code never confirmed
}

model Producer {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  name        String?
  keyHash     String    @unique @map("key_hash")
  keyIssuedAt DateTime  @map("key_issued_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  titles      ProducerTitle[]
  withdrawals ProducerWithdrawal[]

  @@map("producers")
}

/// Which producer owns a title, and their share of its ticket revenue.
model ProducerTitle {
  titleId         String   @id @map("title_id") @db.Uuid
  producerId      String   @map("producer_id") @db.Uuid
  producer        Producer @relation(fields: [producerId], references: [id], onDelete: Restrict)
  /// Basis points of net ticket revenue paid to the producer (9000 = 90%).
  revenueShareBps Int      @default(9000) @map("revenue_share_bps")
  assignedAt      DateTime @default(now()) @map("assigned_at")

  @@index([producerId])
  @@map("producer_titles")
}

model ProducerWithdrawal {
  id            String                   @id @default(uuid()) @db.Uuid
  producerId    String                   @map("producer_id") @db.Uuid
  producer      Producer                 @relation(fields: [producerId], references: [id], onDelete: Restrict)
  amountMinor   Int                      @map("amount_minor") // kobo
  bankName      String                   @map("bank_name")
  accountNumber String                   @map("account_number")
  accountName   String                   @map("account_name")
  status        ProducerWithdrawalStatus @default(AWAITING_CONFIRMATION)
  codeHash      String?                  @map("code_hash")
  codeExpiresAt DateTime?                @map("code_expires_at")
  codeAttempts  Int                      @default(0) @map("code_attempts")
  requestedAt   DateTime?                @map("requested_at")
  reviewedAt    DateTime?                @map("reviewed_at")
  reviewedById  String?                  @map("reviewed_by_id") @db.Uuid
  transferRef   String?                  @map("transfer_ref")
  note          String?
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@index([producerId, createdAt])
  @@index([status])
  @@map("producer_withdrawals")
}

/// Simulated Korapay payments, never credited to CoinWallet or producer revenue.
model KorapayTestTopup {
  reference   String          @id
  userId      String          @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coins       Int
  amountMinor Int             @map("amount_minor")
  status      CoinTopupStatus @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@map("korapay_test_topups")
}

/// Transactional alerts captured by database triggers; contains no OTPs or dashboard keys.
model EmailAlert {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventKey       String    @map("event_key")
  recipient      String
  subject        String
  body           String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  firstAttemptAt DateTime? @map("first_attempt_at") @db.Timestamptz
  leaseToken     String?   @map("lease_token") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([eventKey, recipient])
  @@index([status, availableAt], map: "email_alerts_pending_idx")
  @@map("email_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content classification & rule-based homepage. Genres, tags, industries and
// collections are separate many-to-many vocabularies; homepage sections are
// filter rules over them. See docs/content-classification.md.
// ─────────────────────────────────────────────────────────────────────────────

enum ContentFormat {
  FEATURE_FILM
  SHORT_FILM
  TV_SERIES
  LIMITED_SERIES
  MINISERIES
  DOCUMENTARY_FILM
  DOCUMENTARY_SERIES
  ANIMATION_FILM
  ANIMATED_SERIES
  STANDUP_COMEDY
  LIVE_PERFORMANCE
  SPECIAL
  ANTHOLOGY
  REALITY_SERIES
  MUSIC_FILM
}

enum Audience {
  KIDS
  TEENS
  FAMILY
  ADULTS
}

enum AccessType {
  FREE
  SUBSCRIPTION
  PAY_PER_VIEW
  RENTAL
  PURCHASE
  PROMOTIONAL
}

enum TagKind {
  MOOD
  THEME
  SETTING
  CHARACTER
  STORY
}

enum CollectionKind {
  EDITORIAL
  SYSTEM
}

enum ClassificationSource {
  MANUAL
  AUTO
}

enum HomeSectionKind {
  RULE
  CONTINUE_WATCHING
  WATCHLIST
  RECOMMENDED
  BECAUSE_YOU_WATCHED
}

enum HomeSort {
  POPULARITY
  PUBLISHED_DESC
  RELEASE_DESC
  RELEASE_ASC
  RATING_DESC
  PLAYS_1D
  PLAYS_7D
  PLAYS_ALL
  LATEST_EPISODE
  EXPIRING_SOON
  MANUAL
}

/// Genre or subgenre (parentId set). Subgenre slugs are "<parent>-<name>".
model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  parent    Genre?   @relation("GenreTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Genre[]  @relation("GenreTree")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  titles TitleGenre[]

  @@index([parentId])
  @@map("genres")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  kind      TagKind
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  titles TitleTag[]

  @@index([kind])
  @@map("tags")
}

/// Regional/industry label (Nollywood, Kannywood…). `countries`/`languages`
/// drive automatic assignment from a title's production countries/languages.
model Industry {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  position  Int      @default(0)
  countries String[]
  languages String[]
  createdAt DateTime @default(now()) @map("created_at")

  titles TitleIndustry[]

  @@map("industries")
}

/// Editorial (Editor's Picks, Originals…) or legacy system list (trending…).
model Collection {
  id          String         @id @default(uuid()) @db.Uuid
  slug        String         @unique
  name        String
  kind        CollectionKind @default(EDITORIAL)
  description String?
  position    Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")

  titles TitleCollection[]

  @@map("collections")
}

model TitleGenre {
  titleId  String         @map("title_id") @db.Uuid
  title    CatalogueTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genreId  String         @map("genre_id") @db.Uuid
  genre    Genre          @relation(fields: [genreId], references: [id], onDelete: Cascade)
  /// Selection order; the first top-level genre is the primary one.
  position Int            @default(0)

  @@id([titleId, genreId])
  @@index([genreId])
  @@map("title_genres")
}

model TitleTag {
  titleId String         @map("title_id") @db.Uuid
  title   CatalogueTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  tagId   String         @map("tag_id") @db.Uuid
  tag     Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([titleId, tagId])
  @@index([tagId])
  @@map("title_tags")
}

model TitleIndustry {
  titleId    String               @map("title_id") @db.Uuid
  title      CatalogueTitle       @relation(fields: [titleId], references: [id], onDelete: Cascade)
  industryId String               @map("industry_id") @db.Uuid
  industry   Industry             @relation(fields: [industryId], references: [id], onDelete: Cascade)
  source     ClassificationSource @default(MANUAL)

  @@id([titleId, industryId])
  @@index([industryId])
  @@map("title_industries")
}

model TitleCollection {
  titleId      String         @map("title_id") @db.Uuid
  title        CatalogueTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  collectionId String         @map("collection_id") @db.Uuid
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Manual order inside the collection (HomeSort.MANUAL).
  position     Int            @default(0)
  addedAt      DateTime       @default(now()) @map("added_at")

  @@id([titleId, collectionId])
  @@index([collectionId])
  @@map("title_collections")
}

/// One homepage row. RULE sections are computed from `rules` (SectionRules
/// JSON); the other kinds are per-viewer rails the apps fetch separately.
model HomepageSection {
  id               String          @id @default(uuid()) @db.Uuid
  slug             String          @unique
  title            String
  kind             HomeSectionKind @default(RULE)
  rules            Json            @default("{}")
  sort             HomeSort        @default(POPULARITY)
  limit            Int             @default(20)
  /// Shown only with at least this many eligible titles.
  minItems         Int             @default(4) @map("min_items")
  enabled          Boolean         @default(true)
  position         Int             @default(0)
  /// Manual overrides: pinned titles lead the row; excluded never appear.
  pinnedTitleIds   String[]        @map("pinned_title_ids")
  excludedTitleIds String[]        @map("excluded_title_ids")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([enabled, position])
  @@map("homepage_sections")
}
